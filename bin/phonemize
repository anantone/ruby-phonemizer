#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'phonemizer'

options = {
  language: Phonemizer::DEFAULT_LANGUAGE,
  phone_sep: '',
  word_sep: ' ',
  strip_stress: true,
  language_switch: :remove,
  workers: Phonemizer::DEFAULT_WORKERS
}

parser = OptionParser.new do |o|
  o.banner = 'Usage: phonemize [options] [text | file]   (no argument: read lines from stdin)'
  o.on('-l', '--language LANG',
       "espeak voice (default: #{Phonemizer::DEFAULT_LANGUAGE})") { |v| options[:language] = v }
  o.on('-p', '--phone-sep SEP',
       'separator between phones (default: none)') { |v| options[:phone_sep] = v }
  o.on('-w', '--word-sep SEP',
       'separator between words in one utterance (default: space)') { |v| options[:word_sep] = v }
  o.on('-s', '--[no-]strip-stress',
       'strip stress marks and liaison hyphens (default: yes)') { |v| options[:strip_stress] = v }
  o.on('-k', '--keep-language-switch',
       'keep inline (en)/(fr) language tags (default: remove)') { options[:language_switch] = :keep }
  o.on('-j', '--workers N', Integer,
       "parallel espeak-ng calls (default: #{Phonemizer::DEFAULT_WORKERS})") { |v| options[:workers] = v }
  o.on('-h', '--help', 'show this help') do
    puts o
    exit
  end
end
begin
  parser.parse!(ARGV)
rescue OptionParser::ParseError => e
  warn "phonemize: #{e.message}"
  warn parser
  exit 1
end

def phonemize_lines(lines, options)
  lines = lines.map(&:chomp).reject(&:empty?)
  Phonemizer.phonemize(lines, **options).each { |line| puts line }
end

begin
  if ARGV.empty?
    if $stdin.tty?
      warn parser
      exit 1
    end
    phonemize_lines($stdin.each_line.to_a, options)
  elsif ARGV.size == 1 && File.file?(ARGV[0])
    phonemize_lines(File.readlines(ARGV[0]), options)
  else
    puts Phonemizer.phonemize(ARGV.join(' '), **options)
  end
rescue Phonemizer::Error, ArgumentError => e
  warn "phonemize: #{e.message}"
  exit 1
end
